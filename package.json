{
  "name": "api-monitoring-alert-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "check:env": "node scripts/check-env.js",
    "repair:workspaces": "node scripts/repair-workspaces.js",
    "verify:live": "node scripts/verify/live.js",
    "verify:stress": "node scripts/verify/stress.js",
    "test": "node --test",
    "predev": "npm --prefix client run build"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0"
  }
}
