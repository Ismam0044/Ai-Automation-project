{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm ci && npm --prefix client ci && npm run build:client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/monitor", "destination": "/api/index?route=/api/monitor" },
    { "source": "/alerts", "destination": "/api/index?route=/api/alerts" },
    { "source": "/alerts/:path*", "destination": "/api/index?route=/api/alerts/:path*" },
    { "source": "/health", "destination": "/api/index?route=/api/health" },
    { "source": "/workspaces", "destination": "/api/index?route=/api/workspaces" },
    { "source": "/workspaces/:path*", "destination": "/api/index?route=/api/workspaces/:path*" },
    { "source": "/api", "destination": "/api/index?route=/api" },
    { "source": "/api/:path*", "destination": "/api/index?route=/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/purge", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
